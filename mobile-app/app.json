{
  "expo": {
    "name": "Les Partenaires DM",
    "slug": "les-partenaires-dm",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "partenairesdm",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/logo.png",
    "splash": {
      "backgroundColor": "#f7f9ff",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.partenairesmultiservices.app",
      "icon": "./assets/logo.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.partenairesmultiservices.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#00236f"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app a besoin d'accéder à vos photos pour documenter une intervention.",
          "cameraPermission": "L'app a besoin d'accéder à votre caméra pour prendre des photos avant/après."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#00236f",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "33cbf8f5-e6ed-4133-9d77-270a4203075a"
      }
    },
    "owner": "marwann7"
  }
}
